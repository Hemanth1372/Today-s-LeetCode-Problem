Given an array arr[] of distinct integers and a range [low, high], 
find all the numbers within the range that are not present in the array. 
return the missing numbers in sorted order.


class Solution {
  public:
    vector<int> missinRange(vector<int>& arr, int low, int high) {
       vector<int> res;
       unordered_set<int> st;
       for(int i : arr) st.insert(i);
       for(int i=low;i<=high;i++) {
           if(st.count(i) > 0) continue;
           else res.push_back(i);
       } 
       
       return res;
    }
};