Given an array arr[] consisting of n integers, the task is to find 
all the array elements which occurs more than floor(n/3) times.

Note: The returned array of majority elements should be sorted.

class Solution {
public:
    vector<int> findMajority(vector<int>& arr) {
        int ele1 = 0, ele2 = 0;
        int cnt1 = 0, cnt2 = 0;
        for (int i : arr) {
            if (i == ele1) {
                cnt1++;
            }
            else if (i == ele2) {
                cnt2++;
            }
            else if (cnt1 == 0) {
                ele1 = i;
                cnt1 = 1;
            }
            else if (cnt2 == 0) {
                ele2 = i;
                cnt2 = 1;
            }
            else {
                cnt1--;
                cnt2--;
            }
        }

        cnt1 = 0,cnt2 = 0;

        for (int i : arr) {
            if (i == ele1) cnt1++;
            else if (i == ele2) cnt2++;
        }

        vector<int> res;
        int n = arr.size();

        if (cnt1 > n / 3) res.push_back(ele1);
        if (cnt2 > n / 3 && ele1!=ele2) res.push_back(ele2);
        sort(res.begin(), res.end());
        return res;
    }
};
