Problem Statement: Given are the two distinct words startWord and targetWord, and a list denoting wordList of unique words of equal lengths. Find the length of the shortest transformation sequence from startWord to targetWord..

In this problem statement, we need to keep the following conditions in mind:

A word can only consist of lowercase characters.
Only one letter can be changed in each transformation.
Each transformed word must exist in the wordList including the targetWord.
startWord may or may not be part of the wordList
Note:  If there’s no possible way to transform the sequence from startWord to targetWord return 0.  

#include<bits/stdc++.h>
using namespace std;
int main() {
  
  vector<string> wordList={"des","der","dfr","dgt","dfs"};
  int n=wordList.size();
  string startWord="der", targetWord="dfs";
  unordered_set<string> st;
  for(auto it:wordList) st.insert(it);
  
  queue<pair<string, int>> q;
  q.push({startWord, 1});
  while(!q.empty()) {
    auto it = q.front();
    q.pop();
    string word=it.first;
    int dist=it.second;
    if(word==targetWord) {
      cout<<dist<<endl;
      return 0;
    }    
    for(int i=0;i<word.size();i++) {
      char ch=word[i];
      for(int j=0;j<26;j++){
        word[i]='a'+j;
        if(st.count(word) > 0) {
          q.push({word, dist+1});
          st.erase(word);
        }
      }
      word[i]=ch;
    }
  }
  
  cout<<-1<<endl; 
  
  return 0;
}
