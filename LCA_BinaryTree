Given the root of a binary tree with all unique values and two nodes value, n1 and n2. 
Your task is to find the lowest common ancestor of the given two nodes. Both node values are always present in the Binary Tree.

Note: LCA is the first common ancestor of both the nodes n1 and n2 from bottom of tree.

/*
class Node {
public:
    int data;
    Node* left;
    Node* right;

    Node(int x) {
        data = x;
        left = right = NULL;
    }
};
*/

class Solution {
  public:
    Node* lca(Node* root, int n1, int n2) {
        if(!root || root->data == n1 || root->data == n2) return root;
        Node* lh = lca(root->left, n1, n2);
        Node* rh = lca(root->right, n1, n2);
        if(lh == NULL) return rh;
        else if(rh == NULL) return lh;
        else return root;
    }
};
