Problem Statement: Given a directed graph with V vertices and E edges, check whether it contains any cycle or not. 

#include<bits/stdc++.h>
using namespace std;

void dfs(int node, vector<int> &visited, vector<int> &path, vector<vector<int>>& adjList) {
  visited[node]=1;
  path[node]=1;
  for(auto it : adjList[node]) {
    if(!visited[it]) 
      dfs(it, visited, path, adjList);
    else if(it != node && path[it] == 1){
      cout<<"There is a loop"<<endl;
      return ;
    }
  }
  
  return ;
}

int main() {
 
  int n,m;
  cin>>n>>m;
  vector<vector<int>> adjList(n);
  for(int i=0;i<m;i++) {
    int u, v;
    cin>>u>>v;
    adjList[u].push_back(v);
  }
  
  vector<int> visited(n), path(n);
  
  for(int i=0;i<n;i++) {
    if(!visited[i]) {
      dfs(i, visited, path, adjList);
    } 
  } 
    
  return 0;
}

