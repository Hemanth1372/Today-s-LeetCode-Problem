Given an array of integers arr[] representing non-negative integers, arrange them so that 
after concatenating all of them in order, it results in the largest possible number. Since 
the result may be very large, return it as a string.



class Solution {
  public:
    string findLargest(vector<int> &arr) {
        vector<string> nums;
        
        for(int x : arr)
            nums.push_back(to_string(x));

        sort(nums.begin(), nums.end(), [](string &a, string &b) {
            return a + b > b + a;
        });

        if(nums[0] == "0")
            return "0";

        string result = "";
        for(string &s : nums)
            result += s;

        return result;
    }
};
